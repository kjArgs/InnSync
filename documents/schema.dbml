// InnSync: online-only reservation MVP.
// Logical relationship schema; see DATABASE-RELATIONSHIPS.md for PostgreSQL
// CHECKs, overlap protection, partial indexes, and transaction requirements.
Project innsync {
  database_type: 'PostgreSQL'
  Note: 'One hotel, one room per customer-created online booking. No staff reservation creation or payment gateway. IDs generated by the application.'
}

Table users {
  id uuid [pk]
  name varchar(200) [not null]
  email_normalized varchar(254) [not null, unique]
  phone varchar(40) [null]
  password_hash varchar(255) [not null]
  role varchar(20) [not null]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Identity. customer, receptionist, admin. Public registration always customer; only admin creates staff. Configure the Eloquent authenticatable model for password_hash.'
}

Table auth_sessions {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  revoked_at timestamptz [null]
  Note: 'Identity. JWT sid points here. Validate signature and current session/account on each protected request. No raw access token and no refresh token stored.'
}

Table password_reset_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  token_hash varchar(255) [not null, unique]
  created_at timestamptz [not null]
  expires_at timestamptz [not null]
  consumed_at timestamptz [null]
  Note: 'Identity. Single-use opaque reset secret, hashed. Purpose only password recovery. Adapter/custom broker must match this schema; not an assertion of Laravel default columns.'
}

Table room_types {
  id uuid [pk]
  name varchar(100) [not null, unique]
  description text [null]
  capacity int [not null]
  nightly_rate decimal(12,2) [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Rooms. Capacity positive, nightly rate nonnegative. Price/capacity taken from type; no per-room pricing overrides.'
}

Table rooms {
  id uuid [pk]
  room_type_id uuid [not null, ref: > room_types.id]
  room_number varchar(30) [not null, unique]
  floor int [null]
  readiness varchar(16) [not null, default: 'ready']
  is_active boolean [not null, default: true]
  version int [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  Note: 'Rooms owns inventory; Housekeeping commands own readiness. ready, dirty, cleaning. Physical occupancy is derived from bookings.'
}

Table bookings {
  id uuid [pk]
  reference varchar(40) [not null, unique]
  customer_id uuid [not null, ref: > users.id]
  room_id uuid [not null, ref: > rooms.id]
  source varchar(10) [not null, default: 'online']
  guest_name_snapshot varchar(200) [not null]
  guest_email_snapshot varchar(254) [not null]
  guest_phone_snapshot varchar(40) [not null]
  room_number_snapshot varchar(30) [not null]
  room_type_snapshot varchar(100) [not null]
  capacity_snapshot int [not null]
  check_in_date date [not null]
  check_out_date date [not null]
  scheduled_check_in_at timestamptz [not null]
  scheduled_check_out_at timestamptz [not null]
  no_show_cutoff_at timestamptz [not null]
  adults int [not null]
  children int [not null, default: 0]
  nightly_rate_snapshot decimal(12,2) [not null]
  total_amount decimal(12,2) [not null]
  currency char(3) [not null]
  status varchar(20) [not null, default: 'confirmed']
  actual_check_in_at timestamptz [null]
  actual_check_out_at timestamptz [null]
  special_requests text [null]
  version int [not null, default: 1]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (room_id, check_in_date, check_out_date)
    (customer_id, created_at)
    (status, check_in_date)
    (status, check_out_date)
  }
  Note: 'Reservations. Customer owner comes from JWT user; staff cannot create. source CHECK online. confirmed, checked_in, checked_out, cancelled, no_show. PostgreSQL exclusion and partial unique constraints are required separately.'
}

Table payments {
  id uuid [pk]
  booking_id uuid [not null, ref: > bookings.id]
  recorded_by uuid [not null, ref: > users.id]
  type varchar(16) [not null]
  original_payment_id uuid [null, ref: > payments.id]
  amount decimal(12,2) [not null]
  method varchar(30) [not null]
  reference_namespace varchar(80) [null]
  external_reference varchar(255) [null]
  reason text [null]
  received_at timestamptz [not null]
  created_at timestamptz [not null]
  indexes {
    (reference_namespace, external_reference) [unique]
    (booking_id, received_at)
  }
  Note: 'Payments. Posted collections/refunds only, positive amounts; cash or bank_transfer. Refund requires original collection on same cancelled/no_show booking and reason. Currency inherited from booking; no gateway or card data.'
}

Table booking_events {
  id uuid [pk]
  booking_id uuid [not null, ref: > bookings.id]
  actor_id uuid [not null, ref: > users.id]
  payment_id uuid [null, ref: > payments.id]
  event_type varchar(50) [not null]
  from_status varchar(20) [null]
  to_status varchar(20) [null]
  reason text [null]
  created_at timestamptz [not null]
  indexes { (booking_id, created_at) }
  Note: 'Reservations history. Append-only. Payment link, when present, must belong to same booking. Internal reasons filtered from customer API.'
}

Table room_readiness_events {
  id uuid [pk]
  room_id uuid [not null, ref: > rooms.id]
  booking_id uuid [null, ref: > bookings.id]
  actor_id uuid [not null, ref: > users.id]
  from_readiness varchar(16) [null]
  to_readiness varchar(16) [not null]
  reason text [null]
  created_at timestamptz [not null]
  indexes { (room_id, created_at) }
  Note: 'Housekeeping. Checkout, start cleaning, complete cleaning. Normal turnover carries originating checkout booking. Null booking/from state only for initial configuration. Linked booking must refer to this room.'
}

Table idempotency_requests {
  id uuid [pk]
  actor_id uuid [not null, ref: > users.id]
  operation varchar(120) [not null]
  request_key varchar(100) [not null]
  request_hash varchar(255) [not null]
  response_status int [not null]
  response_body text [not null]
  created_at timestamptz [not null]
  indexes { (actor_id, operation, request_key) [unique] }
  Note: 'Shared infrastructure. Committed with successful command. Safe response only; operation includes target resource. Unique conflict rolls back business writes then reads committed original outcome. No short automatic expiry for business commands.'
}
